# Copie ce fichier en .env — .env est ignoré par git et ne doit JAMAIS être commité.
# Une variable manquante fait échouer le démarrage en la nommant (packages/env).

NODE_ENV=development

# --- web ---
APP_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-anon-key

SUPABASE_URL=http://127.0.0.1:54521

# --- worker (secrets : jamais exposés au navigateur) ---
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key
ANTHROPIC_API_KEY=replace-me-anthropic-key

# OPTIONNELLE — le fournisseur de SECOURS. Sans elle, le produit fonctionne :
# il n'a simplement pas de filet si Anthropic est en panne ou a court de credit.
# La bascule ne joue QUE sur les pannes, jamais sur un refus du modele.
OPENROUTER_API_KEY=
