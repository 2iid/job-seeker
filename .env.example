# Copie ce fichier en .env — .env est ignoré par git et ne doit JAMAIS être commité.
# Une variable manquante fait échouer le démarrage en la nommant (packages/env).

NODE_ENV=development

# --- web ---
APP_URL=http://localhost:3100
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me-anon-key

# --- worker (secrets : jamais exposés au navigateur) ---
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key
ANTHROPIC_API_KEY=replace-me-anthropic-key
